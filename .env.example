# MotoDNA Environment Variables Template
# Copy this file to .env.local for development, or configure in your deployment platform.

MONGO_URL=mongodb://localhost:27017
DB_NAME=motodna

# Minimum 32 characters, cryptographically secure.
# Generate with: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Comma-separated admin emails (auto-granted is_admin on register/login)
ADMIN_EMAILS=admin@motodna.app

# CORS allowed origins (in production, set your actual domain, e.g. https://motodna.app)
CORS_ORIGINS=http://localhost:3000

NODE_ENV=development
